# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL / Supavisor)
# ------------------- -----------------------------------------------------------
# Conexão com pooling Supavisor (Porta 6543)
DATABASE_URL="postgresql://postgres.tacrpktefuolrgsnbkej:[SUA-SENHA]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (Porta 5432 - obrigatória para migrações do Prisma sem pgbouncer)
DIRECT_URL="postgresql://postgres.tacrpktefuolrgsnbkej:[SUA-SENHA]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH & AUTENTICAÇÃO
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="your-super-secret-nextauth-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth (Opcional para ambiente web mobile)
APPLE_ID="com.yourdomain.saas"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 3. STRIPE (Monetização, Assinaturas e Webhooks)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# IDs de preços configurados no dashboard do Stripe
STRIPE_PRICE_ID_BASIC="price_basic_tier_monthly_id"
STRIPE_PRICE_ID_PRO="price_pro_tier_monthly_id"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 (Armazenamento S3 de Fotos, Vídeos e Logos)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="review14-media"
CLOUDFLARE_R2_PUBLIC_URL="https://media.yourdomain.com"

# ------------------------------------------------------------------------------
# 5. DISPARO DE E-MAIL (Código OTP e Notificações)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Review14 <nao-responda@yourdomain.com>"

# ------------------------------------------------------------------------------
# 6. URLS PÚBLICAS DOS APPS DO MONOREPO (Portas de Desenvolvimento)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_TENANT_URL="http://localhost:3002"
