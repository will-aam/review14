// packages/core/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Recomendado para conexões com pooling no Neon
}

// ==========================================
// ENUMS (Tipagens e Controles de Estado)
// ==========================================

enum Role {
  SUPER_ADMIN // Você (Dono do SaaS)
  TENANT      // Lojista (Dono do Estabelecimento)
  CUSTOMER    // Cliente Final (Quem avalia)
}

enum AuthProvider {
  GOOGLE
  APPLE
  EMAIL_OTP
  CREDENTIALS // Email e senha para Lojista e Super Admin
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PlanTier {
  BASIC // Apenas 5 estrelas geral + comentário (Ex: R$ 29,90)
  PRO   // Libera subcategorias de estrelas, acordeons e perguntas prontas
}

enum FieldType {
  RATING_5      // Subcategorias de estrelas (Ex: Comida, Serviço, Ambiente)
  SINGLE_SELECT // Perguntas prontas (Ex: Comeu no local, retirou ou entrega?)
  MULTI_SELECT  // Acordeons expansíveis (Ex: Opções vegetarianas, Estacionamento)
  TEXT          // Pergunta aberta extra (Ex: O que você pediu?)
}

enum MediaType {
  IMAGE
  VIDEO
}

// ==========================================
// 1. IDENTIDADE GLOBAL E AUTENTICAÇÃO
// ==========================================

model User {
  id           String       @id @default(cuid())
  email        String       @unique // Chave única para não duplicar o cliente entre várias lojas
  name         String
  avatarUrl    String?      // Foto do Google/Apple ou avatar minimalista da biblioteca
  passwordHash String?      // Usado apenas para login de TENANT ou SUPER_ADMIN
  
  role         Role         @default(CUSTOMER)
  authProvider AuthProvider @default(EMAIL_OTP)
  providerId   String?      // Sub/ID retornado pela Apple ou Google

  // Enriquecimento progressivo (Não obrigatórios na triagem)
  gender       String?
  birthDate    DateTime?    // Melhor que "idade" fixa para automações de marketing
  zipCode      String?      // CEP
  neighborhood String?      // Bairro
  city         String?
  state        String?

  // Relacionamentos
  companies    Company[]      // Se for TENANT, empresas que ele administra
  reviews      Review[]       // Histórico global de avaliações feitas pelo cliente
  tenantLeads  CustomerLead[] // Vínculo de CRM com os estabelecimentos que ele já avaliou

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // Código OTP numérico enviado por e-mail
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email, code])
}

// ==========================================
// 2. LOJISTA (TENANT) E MONETIZAÇÃO (STRIPE)
// ==========================================

model Company {
  id          String   @id @default(cuid())
  slug        String   @unique // Usado na URL do QR Code: app.com/avaliar/[slug]
  
  // Dados puxados automaticamente via Brasil API no Onboarding
  cnpj        String   @unique
  legalName   String   // Razão Social
  tradeName   String   // Nome Fantasia
  category    String   // Categoria (Restaurante, Clínica, Salão, etc.)
  logoUrl     String?  // Armazenado no Cloudflare R2
  
  // Endereço da Empresa
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  phone        String?

  // Configurações de Triagem e Redirecionamento
  googlePlaceId       String? // ID para redirecionar clientes que deram 4 ou 5 estrelas
  minRatingForGoogle  Int     @default(4) // Nota mínima que aciona o convite pro Google

  // Controle Financeiro e Assinatura (Stripe)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  planTier               PlanTier           @default(BASIC)
  subscriptionStatus     SubscriptionStatus @default(TRIALING)
  currentPeriodEnd       DateTime?

  // Relacionamento com o Dono do Estabelecimento
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relacionamentos do Ecossistema da Loja
  reviews      Review[]
  customFields CustomField[]
  leads        CustomerLead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([cnpj])
  @@index([ownerId])
}

// Tabela de CRM do Lojista (Vincula o Usuário Global à Empresa específica sem duplicar conta)
model CustomerLead {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketingOptIn  Boolean  @default(true) // Permissão para disparos de e-mail/campanhas
  totalReviews    Int      @default(1)
  lastVisitedAt   DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, userId]) // Garante que o cliente só entre 1 vez na lista daquela loja
  @@index([companyId])
}

// ==========================================
// 3. MOTOR DE AVALIAÇÕES E MÍDIA (CLOUDFLARE)
// ==========================================

model Review {
  id              String   @id @default(cuid())
  
  // Nota Geral Obrigatória (1 a 5 estrelas) e Comentário Principal
  overallRating   Int      // Validado no Zod entre 1 e 5
  comment         String?  @db.Text

  // Identificação do Avaliador
  isAnonymous     Boolean  @default(false)
  anonymousName   String?  // Nome aleatório gerado no front se não fizer login
  anonymousAvatar String?  // Avatar da biblioteca se não fizer login
  
  // Se fez login (Google, Apple ou OTP), vincula à Conta Global
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Vínculo Obrigatório com a Empresa avaliada
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Controle de Feed e Ouvidoria Interna
  isPublic        Boolean  @default(true) // Notas baixas podem ficar ocultas do feed público
  merchantReply   String?  @db.Text       // Resposta do dono do estabelecimento
  repliedAt       DateTime?

  // Contexto opcional (Caso queira passar via URL/PDV no futuro)
  amountSpent     Decimal? @db.Decimal(10, 2)

  // Relacionamentos da Avaliação
  media           ReviewMedia[]
  customAnswers   CustomAnswer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, createdAt(sort: Desc)]) // Otimiza o carregamento do Feed da loja
  @@index([userId]) // Otimiza o botão "Ver minhas avaliações" do cliente
}

model ReviewMedia {
  id        String    @id @default(cuid())
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url       String    // URL pública do arquivo no Cloudflare R2
  fileKey   String    // Chave interna no bucket do R2 (útil caso precise deletar o arquivo)
  type      MediaType @default(IMAGE)
  sizeBytes Int?

  createdAt DateTime  @default(now())

  @@index([reviewId])
}

// ==========================================
// 4. CAMPOS DINÂMICOS (UPSELL / PLANO PRO)
// ==========================================

model CustomField {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label       String    // Ex: "Comida", "Nível de barulho", "Opções Vegetarianas"
  description String?   // Subtítulo explicativo opcional
  fieldType   FieldType @default(RATING_5)
  
  // Se for SINGLE_SELECT ou MULTI_SELECT, guarda as opções prontas (Ex: ["No local", "Retirada", "Entrega"])
  options     Json?     
  
  order       Int       @default(0) // Ordem de exibição no formulário do cliente
  isActive    Boolean   @default(true)

  answers     CustomAnswer[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, isActive, order])
}

model CustomAnswer {
  id            String      @id @default(cuid())
  
  reviewId      String
  review        Review      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  // Armazena o valor dependendo do tipo do campo configurado pelo lojista
  ratingValue   Int?        // Usado se o campo for RATING_5 (1 a 5 estrelas)
  textValue     String?     // Usado se for TEXT ou SINGLE_SELECT
  selectedItems Json?       // Usado se for MULTI_SELECT (Acordeon com várias marcações)

  createdAt     DateTime    @default(now())

  @@unique([reviewId, customFieldId]) // Uma resposta por campo em cada avaliação
  @@index([reviewId])
  @@index([customFieldId])
}
