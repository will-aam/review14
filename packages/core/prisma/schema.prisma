// packages/core/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS (Tipagens e Controles de Estado)
// ==========================================

enum Role {
  SUPER_ADMIN // Dono do SaaS
  TENANT      // Lojista (Dono do Estabelecimento)
  CUSTOMER    // Cliente Final (Quem avalia)
}

enum AuthProvider {
  GOOGLE
  APPLE
  EMAIL_OTP
  CREDENTIALS // Email e senha para Lojista e Super Admin
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PlanTier {
  BASIC // Apenas 5 estrelas geral + comentário
  PRO   // Libera subcategorias de estrelas, acordeons e perguntas prontas
}

enum FieldType {
  RATING_5      // Subcategorias de estrelas (Ex: Comida, Serviço, Ambiente)
  SINGLE_SELECT // Perguntas prontas (Ex: Comeu no local, retirou ou entrega?)
  MULTI_SELECT  // Acordeons expansíveis (Ex: Opções vegetarianas, Estacionamento)
  TEXT          // Pergunta aberta extra (Ex: O que você pediu?)
}

enum MediaType {
  IMAGE
  VIDEO
}

// ==========================================
// 1. IDENTIDADE GLOBAL E AUTENTICAÇÃO
// ==========================================

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String?      // WhatsApp / Contato do cliente (CRM)
  avatarUrl    String?
  passwordHash String?
  
  role         Role         @default(CUSTOMER)
  authProvider AuthProvider @default(EMAIL_OTP)
  providerId   String?
  isActive     Boolean      @default(true) // Moderação pelo Super Admin

  // Enriquecimento progressivo
  gender       String?
  birthDate    DateTime?
  zipCode      String?
  neighborhood String?
  city         String?
  state        String?

  // Relacionamentos
  companies    Company[]
  reviews      Review[]
  tenantLeads  CustomerLead[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // Código OTP de 6 dígitos
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([expiresAt])
}

// ==========================================
// 2. LOJISTA (TENANT) E MONETIZAÇÃO
// ==========================================

model Company {
  id                 String   @id @default(cuid())
  slug               String   @unique
  cnpj               String?  @unique
  legalName          String
  tradeName          String
  category           String
  logoUrl            String?
  isActive           Boolean  @default(true) // Bloqueio manual do Super Admin
  
  // Endereço e Contato
  zipCode            String?
  street             String?
  number             String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?
  phone              String?

  // Triagem e Redirecionamento
  googlePlaceId      String?
  customRedirectUrl  String?  // Fallback opcional (WhatsApp, TripAdvisor, etc.)
  minRatingForGoogle Int      @default(4)

  // Stripe & Assinaturas
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  planTier             PlanTier           @default(BASIC)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?

  // Relacionamento com o Lojista
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relacionamentos
  reviews      Review[]
  customFields CustomField[]
  leads        CustomerLead[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ownerId])
}

model CustomerLead {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketingOptIn  Boolean  @default(true)
  totalReviews    Int      @default(1)
  notes           String?  // Anotações internas do lojista
  lastVisitedAt   DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId]) // Otimiza busca de lojas frequentadas pelo cliente
}

// ==========================================
// 3. AVALIAÇÕES E MÍDIA
// ==========================================

model Review {
  id              String   @id @default(cuid())
  overallRating   Int      // 1 a 5 estrelas
  comment         String?  @db.Text

  // Identificação do Avaliador
  isAnonymous     Boolean  @default(false)
  anonymousName   String?
  anonymousAvatar String?
  
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Ouvidoria e Feed
  isPublic        Boolean  @default(true)
  isResolved      Boolean  @default(false) // Controle de resolução de queixas na ouvidoria
  merchantReply   String?  @db.Text
  repliedAt       DateTime?

  amountSpent     Decimal? @db.Decimal(10, 2)

  media           ReviewMedia[]
  customAnswers   CustomAnswer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, isPublic, createdAt(sort: Desc)]) // Otimizado para o Feed público e Ouvidoria
  @@index([userId])
}

model ReviewMedia {
  id        String    @id @default(cuid())
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url       String
  fileKey   String
  type      MediaType @default(IMAGE)
  sizeBytes Int?

  createdAt DateTime  @default(now())

  @@index([reviewId])
}

// ==========================================
// 4. CAMPOS DINÂMICOS (PLANO PRO)
// ==========================================

model CustomField {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label       String
  description String?
  fieldType   FieldType @default(RATING_5)
  options     Json?     
  order       Int       @default(0)
  isActive    Boolean   @default(true)

  answers     CustomAnswer[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, isActive, order])
}

model CustomAnswer {
  id            String      @id @default(cuid())
  reviewId      String
  review        Review      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  ratingValue   Int?
  textValue     String?
  selectedItems Json?

  createdAt     DateTime    @default(now())

  @@unique([reviewId, customFieldId])
  @@index([reviewId])
  @@index([customFieldId])
}
